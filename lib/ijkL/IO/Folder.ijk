// ==============================================================================
// ijkLang (ijkL) Standard Framework - Directory and Folder Operations
// Canonical Unit: ijkL.IO.Folder (Aliases: ijkL.ES.Pasta)
// ==============================================================================

unit ijkL.IO.Folder {

    // --------------------------------------------------------------------------
    // Public Folder Manipulation Functions
    // --------------------------------------------------------------------------

    public exists(string folder_path): bool {
        asm {
            r1 := [ra, 0];
            in 0x0110, r0;
            free_frame;
            return r0;
        }
    }

    public create(string folder_path): bool {
        asm {
            r1 := [ra, 0];
            in 0x0111, r0;
            free_frame;
            return r0;
        }
    }

    public delete(string folder_path): bool {
        asm {
            r1 := [ra, 0];
            in 0x0112, r0;
            free_frame;
            return r0;
        }
    }

    public getCurrent(): string {
        asm {
            in 0x0113, r0;
            free_frame;
            return r0;
        }
    }

    public setCurrent(string folder_path): bool {
        asm {
            r1 := [ra, 0];
            in 0x0114, r0;
            free_frame;
            return r0;
        }
    }
}
