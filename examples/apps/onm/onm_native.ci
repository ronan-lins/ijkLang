    out 0x0000, '\n';
    r0 := "  add key <name> [value]        Create a key with an optional string value.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  list nodes                    List the names of immediate child nodes.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  list keys                     List the names and values of keys.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  ren node <name> <new_name>    Rename a child node.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  ren key <name> <new_name>     Rename a key.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  update <key> <new_value>      Change the value of an existing key.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  del node <name>               Physically delete a node and its contents.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  del key <name>                Physically delete a key.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  open <name>                   Enter a child node.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  close                         Return to the parent node.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  show node <name> [recursive]  Display a child node's contents as JSON.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  show node . [recursive]       Display the current node's contents as JSON.";
    out 0x0001, r0;
    out 0x0000, '\n';
    r0 := "  help [command]                Display help for a specific command.";
